# Ambiente de execucao: development | test | production
NODE_ENV=development
PORT=3333
LOG_LEVEL=info

# Conexao MySQL. Caracteres especiais da senha precisam ser percent-encoded
# (por exemplo "@" vira "%40"), senao a URL e interpretada errado.
DATABASE_URL="mysql://usuario:senha@host:3306/unimonitor"

# Opcional: banco vazio e exclusivo usado como shadow database. Defina apenas
# se quiser usar `prisma migrate dev` (ver a secao Migrations no README).
# SHADOW_DATABASE_URL="mysql://usuario:senha@host:3306/unimonitor_shadow"

# Origens autorizadas a chamar a API com cookies (separadas por virgula)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Segredos distintos para access e refresh token.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=troque-este-valor
JWT_REFRESH_SECRET=troque-este-valor-tambem
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Nome dos cookies e dominio opcional para producao
COOKIE_ACCESS_NAME=unimonitor_at
COOKIE_REFRESH_NAME=unimonitor_rt
COOKIE_DOMAIN=

# Usuario administrador criado pelo seed
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@unimonitor.local
SEED_ADMIN_PASSWORD=troque-esta-senha

# Em producao o Swagger (/api/docs) exige cookie de administrador.
# Em development permanece aberto para facilitar o trabalho local.
